# Backend (Vercel Functions — NUNCA expor no frontend)
SUPABASE_URL=https://llsqqbbhcdosrtpvvkml.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_jwt>
SUPABASE_DB_URL=postgresql://postgres.llsqqbbhcdosrtpvvkml:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# admin-pipeelo
PIPEELO_ADMIN_API_URL=https://admin.pipeelo.com
PIPEELO_ADMIN_API_TOKEN=<token_dedicado_ou_usar_email_password>
# PIPEELO_ADMIN_EMAIL=
# PIPEELO_ADMIN_PASSWORD=

# Email transacional
RESEND_API_KEY=<resend_api_key>
RESEND_FROM_EMAIL=Pipeelo Ops <ops@mail.pipeelo.com>

# Alerta interno (Plan 05-03 — UI-07)
# ALERT_FELIPE_EMAIL: destinatario do JarvisFailedAlert. Se ausente, cai pra ALERT_OPS_EMAIL.
ALERT_FELIPE_EMAIL=
ALERT_OPS_EMAIL=

# Webhook token compartilhado com admin-pipeelo (mesmo segredo).
ONBOARDING_WEBHOOK_TOKEN=<token_compartilhado>

# Evolution API (cadastro com grupo WhatsApp)
# URL base da instância Evolution usada para criar o grupo do cliente.
EVOLUTION_API_BASE_URL=<url_evolution>
# Instância dedicada a GRUPO (criar, adicionar, promover, convite e mensagem em grupo).
# Existe porque o número Avisos é deslogado pelo WhatsApp (401) em escrita de grupo.
# Sem as duas, tudo volta a sair pela instância principal.
EVOLUTION_GROUP_INSTANCE=Grupos
EVOLUTION_GROUP_API_KEY=<apikey_da_instancia_de_grupos>
# Nome da instância Evolution que envia os avisos.
EVOLUTION_API_INSTANCE=Avisos
# Chave de autenticação da instância Evolution.
EVOLUTION_API_KEY=<evolution_api_key>
# JID do grupo interno do Staff que recebe o aviso de novo cadastro.
STAFF_GROUP_JID=120363428470826804@g.us
# URL pública do serviço, usada para montar o link curto de convite.
PUBLIC_BASE_URL=https://onboarding.pipeelo.com

# Upstash Redis (rate limit e cache de CNPJ; obrigatórias para /api/sessions/create e /api/sessions/cadastro-submit)
UPSTASH_REDIS_REST_URL=<upstash_redis_rest_url>
UPSTASH_REDIS_REST_TOKEN=<upstash_redis_rest_token>

# Contrato automático (leitura dos documentos por IA) — pós-cadastro
# Chave da OpenAI usada para ler contrato social e documento pessoal.
OPENAI_API_KEY=<openai_api_key>
# Modelo da extração. Padrão: gpt-5-mini.
OPENAI_MODEL_EXTRACAO=gpt-5-mini

# Conta Azul (cobrança da implantação e da 1ª mensalidade) — pós-cadastro
# Segredo compartilhado com o router /api/conta-azul do site de vendas.
CA_INTERNAL_SECRET=<segredo_compartilhado_com_o_site>
# Base do site de vendas. Domínio primário: vendas.pipeelo.com só redireciona
# e o redirect pode descartar o corpo do POST.
VENDAS_API_URL=https://pipeelo.com

# ── AssinaPDF (assinatura do contrato) ──────────────────────
# Token do usuário com "Habilita API" (Configurações › Usuários). Nunca no repo.
ASSINAPDF_TOKEN=<token_assinapdf>
ASSINAPDF_BASE_URL=https://pipeelo.assinapdf.com.br
# IDs configurados no painel em 02/09/2026: Empresa 1 = PIPEELO LTDA, categoria 2 = Comercial, layout 2 = "Contrato Pipeelo".
ASSINAPDF_EMPRESA_ID=1
ASSINAPDF_CATEGORIA_ID=2
ASSINAPDF_LAYOUT_ID=2
ASSINAPDF_TIPO=Contratação
# Polling do status (a AssinaPDF não tem webhook). 0 desliga.
ASSINATURA_POLL_MINUTOS=10
